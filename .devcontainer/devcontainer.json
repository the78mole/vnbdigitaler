{
  "name": "Python 3 with uv and PostgreSQL",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "true",
      "configureZshAsDefaultShell": "true",
      "installOhMyZsh": "true"
    },
    "ghcr.io/devcontainers/features/docker-in-docker": {},
    "ghcr.io/the78mole/devcontainer-features/uv:1": {
      "version": "latest"
    },
    "ghcr.io/the78mole/devcontainer-features/postgresql:1": {
      "version": "16"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "streamlit_app.py"
      ]
    },
    "vscode": {
      "settings": {
        "terminal.integrated.env.linux": {
          "PYTHONPATH": "${workspaceFolder}/src",
          "PATH": "/home/vscode/.local/bin:${env:PATH}",
          "DATABASE_URL": "postgresql://postgres@localhost:5432/postgres"
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ckolkman.vscode-postgres"
      ]
    }
  },
  "updateContentCommand": ".devcontainer/updateContentCommand.sh",
  "postAttachCommand": {
    "server": "export PATH=\"$HOME/.local/bin:$PATH\" && uv run streamlit run streamlit_app.py --server.enableCORS false --server.enableXsrfProtection false --server.headless true --server.address 0.0.0.0 --server.port 8501"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": ".devcontainer/postCreateCommand.sh",
  "forwardPorts": [
    8501,
    5432
  ]
}
