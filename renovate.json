{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    ":ignoreUnstable",
    ":prImmediately",
    ":updateNotScheduled",
    ":automergeDisabled",
    ":maintainLockFilesWeekly"
  ],
  "prConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "📦 Renovate Dependency Dashboard",
  "commitMessagePrefix": "⬆️ ",
  "commitMessageAction": "{{#if isGroup}}{{groupName}}{{else}}{{depName}}{{/if}} {{#if isMajor}}(major){{/if}}{{#if displayFrom}} from {{displayFrom}}{{/if}}{{#if displayTo}} to {{displayTo}}{{/if}}",
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group all pre-commit hooks updates",
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit hooks",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Auto-merge pre-commit hooks minor updates",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "GitHub Actions dependencies",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci"
    },
    {
      "description": "Auto-merge GitHub Actions patch updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Python dependencies grouping",
      "matchManagers": [
        "pip_requirements",
        "pip_setup",
        "pipenv",
        "poetry"
      ],
      "groupName": "Python dependencies",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Development dependencies",
      "matchDepTypes": [
        "devDependencies"
      ],
      "groupName": "Development dependencies",
      "semanticCommitType": "chore",
      "semanticCommitScope": "dev-deps"
    }
  ],
  "timezone": "Europe/Berlin",
  "assignees": [
    "the78mole"
  ],
  "reviewers": [
    "the78mole"
  ]
}
