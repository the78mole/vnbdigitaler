# Prefect Development Environment Configuration

# Prefect Server Configuration
PREFECT_API_URL=http://localhost:4200/api
PREFECT_WORKER_HEARTBEAT_SECONDS=30
PREFECT_LOGGING_LEVEL=INFO

# VNB Digitaler Development Settings
VNB_ENV=development
VNB_DATABASE_URL=sqlite+aiosqlite:///app/data/vnb_digitaler.db
VNB_ENABLE_DEBUG_LOGGING=true
VNB_DRY_RUN_MODE=true

# Work Pool Configuration
VNB_PREFECT_WORK_POOL=vnb-digitaler-dev
VNB_MAX_CONCURRENT_FLOWS=2
VNB_TASK_TIMEOUT_SECONDS=1800

# External APIs (Development/Mock)
VNB_BDEW_API_BASE_URL=http://localhost:8001/mock/bdew
VNB_BNETZA_BASE_URL=http://localhost:8001/mock/bnetza

# Storage Configuration
VNB_R2_BUCKET_NAME=vnb-digitaler-dev
VNB_LOCAL_STORAGE_PATH=/app/data/storage

# Monitoring
VNB_MONITORING_ENABLED=true
VNB_METRICS_EXPORT_ENABLED=false

# Performance Settings
VNB_PARALLEL_PROCESSING_LIMIT=3
VNB_PDF_PROCESSING_TIMEOUT=300

# Development Features
VNB_ENABLE_FLOW_DEBUGGING=true
VNB_SAVE_INTERMEDIATE_RESULTS=true
VNB_VERBOSE_LOGGING=true

# Database Migration Settings (for future Neon migration)
# VNB_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/vnb_digitaler  # pragma: allowlist secret
# VNB_DATABASE_SSL_MODE=require
# VNB_DATABASE_POOL_SIZE=10
# VNB_DATABASE_MAX_OVERFLOW=20
