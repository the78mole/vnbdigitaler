# VNBdigitaler Environment Variables Template
# Kopiere diese Datei zu .env und fülle die Werte aus

# Database Configuration
NEON_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# AI Services Configuration
OPENROUTER_API_KEY=or-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI Model Configuration
ROLL_OUT_REPORT_FIND_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Object Storage Configuration
CLOUDFLARE_R2_ACCESS_KEY=xxx
CLOUDFLARE_R2_SECRET_KEY=xxx
CLOUDFLARE_R2_BUCKET_NAME=vnb-documents
CLOUDFLARE_R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# Application Configuration
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# Optional: For local development you might want to add:
# DATABASE_ECHO=true  # Show SQL queries in logs
# DISABLE_AUTH=true   # Skip authentication in development
